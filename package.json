{
  "name": "nec-staff-hub-node",
  "version": "1.0.0",
  "description": "NEC Staff Hub – Attendance & Academic Management System",
  "homepage": "https://github.com/RAravinthRaj/nec-staff-hub-node#readme",
  "bugs": {
    "url": "https://github.com/RAravinthRaj/nec-staff-hub-node/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RAravinthRaj/nec-staff-hub-node.git"
  },
  "license": "ISC",
  "author": "Aravinth Raj",
  "type": "commonjs",
  "main": "server.js",
  "scripts": {
    "lint": "eslint src --ext .ts",
    "build": "tsc && mkdir -p dist/templates && cp -r src/templates/* dist/templates/",
    "normalize:leave-documents": "ts-node -r tsconfig-paths/register src/scripts/normalizeLeaveDocuments.ts",
    "sync:oa-attendance-table": "ts-node -r tsconfig-paths/register src/scripts/syncOaAttendanceTable.ts",
    "start": "node dist/server.js",
    "dev": "nodemon --watch \"src/**/*.ts\" --exec \"ts-node\" src/server.ts",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@apollo/server": "^4.12.1",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "axios": "^1.12.2",
    "bcrypt": "^6.0.0",
    "body-parser": "^2.2.0",
    "bullmq": "^5.53.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-graphql": "^0.12.0",
    "express-rate-limit": "^8.3.1",
    "express-session": "^1.19.0",
    "form-data": "^4.0.2",
    "google-auth-library": "^10.5.0",
    "graphql": "16.11.0",
    "graphql-tag": "^2.12.6",
    "handlebars": "^4.7.8",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.17.0",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "sequelize": "^6.37.7",
    "validator": "^13.15.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.2",
    "@types/express-session": "^1.18.2",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.15.2",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/sequelize": "^6.12.0",
    "@types/validator": "^13.15.0",
    "eslint": "^9.25.1",
    "eslint-import-resolver-typescript": "^4.3.4",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3"
  },
  "resolutions": {
    "@types/express": "^5.0.2"
  }
}
